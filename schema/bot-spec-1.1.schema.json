{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aurifex BotSpec 1.1",
  "description": "Input document for bot-spec-1.1.0. bot-spec-1.0.0 documents are normalized before this schema applies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "displayName",
    "stack",
    "features",
    "deployment",
    "storage",
    "i18n",
    "security",
    "runtime"
  ],
  "properties": {
    "schemaVersion": { "const": "bot-spec-1.1.0" },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000-\u001f\u007f]*\\S[^\u0000-\u001f\u007f]*$"
    },
    "stack": { "enum": ["grammy", "aiogram"] },
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "commands",
          "llm",
          "inline",
          "payments",
          "miniapps",
          "moderation",
          "broadcast",
          "widgets",
          "rich"
        ]
      },
      "contains": { "const": "commands" }
    },
    "deployment": { "const": "docker" },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres", "redis"],
      "properties": {
        "postgres": { "type": "boolean" },
        "redis": { "type": "boolean" }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultLocale", "en", "ru"],
      "properties": {
        "defaultLocale": { "enum": ["en", "ru", "zh"] },
        "en": { "type": "boolean" },
        "ru": { "type": "boolean" },
        "zh": { "type": "boolean", "default": false }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": { "en": { "const": true } }
        },
        {
          "type": "object",
          "properties": { "ru": { "const": true } }
        },
        {
          "type": "object",
          "properties": { "zh": { "const": true } }
        }
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "defaultLocale": { "const": "en" } }
          },
          "then": {
            "type": "object",
            "properties": { "en": { "const": true } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "defaultLocale": { "const": "ru" } }
          },
          "then": {
            "type": "object",
            "properties": { "ru": { "const": true } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "defaultLocale": { "const": "zh" } }
          },
          "then": {
            "type": "object",
            "required": ["zh"],
            "properties": { "zh": { "const": true } }
          }
        }
      ]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webhookSecret", "adminAllowlist", "rateLimit", "idempotency"],
      "properties": {
        "webhookSecret": { "const": true },
        "adminAllowlist": { "type": "boolean" },
        "rateLimit": { "type": "boolean" },
        "idempotency": { "type": "boolean" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue", "telemetry"],
      "properties": {
        "queue": { "enum": ["postgres", "none"] },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["otlp", "prometheus", "sentry"],
          "properties": {
            "otlp": { "type": "boolean" },
            "prometheus": { "type": "boolean" },
            "sentry": { "type": "boolean" }
          }
        }
      }
    },
    "miniapps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 2592000,
          "default": 86400
        },
        "allowedOrigins": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^https:\\/\\/[^\\s\\/?#]+$"
          }
        }
      },
      "description": "allowedOrigins entries are canonical https origins; the validator also checks URL canonicality."
    },
    "payments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products"],
      "properties": {
        "products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "description", "stars", "subscription"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[^\u0000-\u001f\u007f]*\\S[^\u0000-\u001f\u007f]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^\u0000-\u001f\u007f]*\\S[^\u0000-\u001f\u007f]*$"
              },
              "stars": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "subscription": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "contains": { "enum": ["llm", "broadcast", "payments"] }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "storage": {
            "type": "object",
            "properties": { "postgres": { "const": true } }
          },
          "runtime": {
            "type": "object",
            "properties": { "queue": { "const": "postgres" } }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "not": {
              "type": "array",
              "contains": { "enum": ["llm", "broadcast", "payments"] }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "runtime": {
            "type": "object",
            "properties": { "queue": { "const": "none" } }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "security": {
                "type": "object",
                "properties": { "idempotency": { "const": true } }
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "security": {
                "type": "object",
                "properties": { "rateLimit": { "const": true } }
              }
            }
          },
          {
            "type": "object",
            "required": ["miniapps"],
            "properties": { "miniapps": true }
          }
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "storage": {
            "type": "object",
            "properties": { "redis": { "const": true } }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["payments"],
        "properties": { "payments": true }
      },
      "then": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "contains": { "const": "payments" }
          }
        }
      }
    }
  ]
}
